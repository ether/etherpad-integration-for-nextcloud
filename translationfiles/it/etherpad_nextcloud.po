#: lib/Controller/PadCreateController.php:87
#: lib/Controller/ViewerControllerErrorMapper.php:50
msgid "Invalid input."
msgstr "Input non valido."

#: lib/Controller/EmbedControllerErrorMapper.php:64
#: lib/Controller/ViewerControllerErrorMapper.php:54
