msgid "Invalid file ID."
msgstr "Identifiant de fichier non valide."

#: lib/Controller/AbstractPadController.php:88
msgid "Invalid parentFolderId."
msgstr "parentFolderId non valide."

#: lib/Controller/AbstractPadController.php:93
msgid "Invalid accessMode. Use public or protected."
msgstr "accessMode non valide. Utilisez public ou protected."

#: lib/Controller/AdminController.php:82 lib/Settings/AdminSettings.php:177
msgid "Settings saved."
msgstr "Paramètres enregistrés."

#: lib/Controller/AdminController.php:90 lib/Settings/AdminSettings.php:182
msgid "Failed to save settings."
msgstr "Impossible d'enregistrer les paramètres."

#: lib/Controller/AdminController.php:128 lib/Settings/AdminSettings.php:183
msgid "Etherpad connection test failed."
msgstr "Impossible de vérifier la connexion à Etherpad."

#: lib/Controller/AdminController.php:150
msgid "Pending pad check finished."
msgstr "Vérification des pads en attente terminée."

#: lib/Controller/AdminController.php:151
msgid "Deleting pads is switched off, so no pad was deleted. The files deleted for good wait for it to be switched on."
msgstr "La suppression des pads est désactivée, aucun pad n'a donc été supprimé. Les fichiers supprimés définitivement attendent qu'elle soit activée."

#: lib/Controller/AdminController.php:157 lib/Settings/AdminSettings.php:185
msgid "Pending pad check failed."
msgstr "La vérification des pads en attente a échoué."

#: lib/Controller/AdminController.php:181
msgid "The pad of this vanished file is marked for deletion. It is deleted within minutes, or at once with \"Check pending pads\"."
msgstr "Le pad de ce fichier disparu est marqué pour suppression. Il est supprimé dans les minutes qui suivent, ou immédiatement avec « Vérifier les pads en attente »."

#: lib/Controller/AdminController.php:182
msgid "The app does not delete this public pad, imported from a .pad file in Ownpad's format. Forget it instead."
msgstr "L'application ne supprime pas ce pad public, importé d'un fichier .pad au format Ownpad. Oubliez-le plutôt."

#: lib/Controller/AdminController.php:190 lib/Settings/AdminSettings.php:138
msgid "Could not delete the pads of the vanished files."
msgstr "Les pads des fichiers disparus n'ont pas pu être supprimés."

#: lib/Controller/AdminController.php:214
msgid "The list of vanished files has changed since it was shown, so no pad was marked for deletion. Check it again."
msgstr "La liste des fichiers disparus a changé depuis son affichage, aucun pad n'a donc été marqué pour suppression. Vérifiez-la à nouveau."

#: lib/Controller/AdminController.php:218
msgid "Not every vanished file could be marked in one go. Run it again for the rest."
msgstr "Tous les fichiers disparus n'ont pas pu être marqués en une fois. Relancez l'opération pour le reste."

#: lib/Controller/AdminController.php:221
msgid "The pads of the vanished files shown are marked for deletion. More files have vanished since: check the list before deleting their pads."
msgstr "Les pads des fichiers disparus affichés sont marqués pour suppression. D'autres fichiers ont disparu depuis : vérifiez la liste avant de supprimer leurs pads."

#: lib/Controller/AdminController.php:222
msgid "No vanished file was left to mark for deletion."
msgstr "Il ne restait aucun fichier disparu à marquer pour suppression."

#: lib/Controller/AdminController.php:223
msgid "The pads of the vanished files are marked for deletion. They are deleted within minutes, or at once with \"Check pending pads\"."
msgstr "Les pads des fichiers disparus sont marqués pour suppression. Ils sont supprimés dans les minutes qui suivent, ou immédiatement avec « Vérifier les pads en attente »."

#: lib/Controller/AdminController.php:229
msgid "Could not delete the pads of all vanished files. Some may be marked for deletion already: check the list again."
msgstr "Les pads de tous les fichiers disparus n'ont pas pu être supprimés. Certains sont peut-être déjà marqués pour suppression : vérifiez à nouveau la liste."

#: lib/Controller/AdminController.php:246
msgid "The pad stays in Etherpad, and the app no longer looks after it."
msgstr "Le pad reste dans Etherpad, et l'application ne s'en occupe plus."

#: lib/Controller/AdminController.php:247
msgid "Only a public pad can be forgotten. Delete a protected one instead."
msgstr "Seul un pad public peut être oublié. Supprimez plutôt un pad protégé."

#: lib/Controller/AdminController.php:255 lib/Settings/AdminSettings.php:145
msgid "Could not forget the pad of the vanished file."
msgstr "Le pad du fichier disparu n'a pas pu être oublié."

#: lib/Controller/AdminController.php:285
msgid "Invalid count."
msgstr "Nombre invalide."

#: lib/Controller/AdminController.php:303
msgid "Deleting pads is switched off, so no pad was marked for deletion."
msgstr "La suppression des pads est désactivée, aucun pad n'a donc été marqué pour suppression."

#: lib/Controller/AdminController.php:308
msgid "This file is no longer vanished; nothing was changed."
msgstr "Ce fichier n'est plus considéré comme disparu ; rien n'a été modifié."

#: lib/Controller/AdminController.php:322 lib/Settings/AdminSettings.php:184
msgid "Consistency check failed."
msgstr "La vérification de cohérence a échoué."

#: lib/Controller/AdminController.php:350
msgid "Could not read the templates."
msgstr "Les modèles n'ont pas pu être lus."

#: lib/Controller/AdminController.php:367
msgid "Template saved."
msgstr "Modèle enregistré."

#: lib/Controller/AdminController.php:370
msgid "Could not save the template."
msgstr "Le modèle n'a pas pu être enregistré."

#: lib/Controller/AdminController.php:384
msgid "Template deleted."
msgstr "Modèle supprimé."

#: lib/Controller/AdminController.php:387
msgid "Could not delete the template."
msgstr "Le modèle n'a pas pu être supprimé."

#: lib/Controller/AdminController.php:398
msgid "All checks passed."
msgstr "Toutes les vérifications ont réussi."

#: lib/Controller/AdminController.php:399
msgid "Check finished. Some settings need attention."
msgstr "Vérification terminée. Certains réglages demandent votre attention."

