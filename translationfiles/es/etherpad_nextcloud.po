#: src/viewer-main.js:444 src/viewer-main.js:464
msgid "Could not load the pad content."
msgstr "No se pudo cargar el contenido del pad."

#: lib/Controller/EmbedController.php:78 src/viewer-main.js:412
msgid "The server did not say where to load this pad from."
msgstr "El servidor no indicó desde dónde cargar este pad."

#: lib/Controller/EmbedController.php:79 src/viewer-main.js:469
#: src/viewer-main.js:519
msgid "Try again"
msgstr "Intentar de nuevo"

#: lib/Controller/EmbedController.php:80 src/viewer-main.js:450
msgid "Refresh"
msgstr "Actualizar"

#: lib/Controller/EmbedController.php:81 src/viewer-main.js:450
msgid "Refreshing..."
msgstr "Actualizando…"

#: lib/Controller/EmbedController.php:82 src/viewer-main.js:580
msgid "Open original pad"
msgstr "Abrir pad original"

#: lib/Controller/EmbedController.php:83 src/viewer-main.js:536
msgid "Checking for the original pad..."
msgstr "Buscando el pad original..."

#: lib/Controller/EmbedController.php:84 src/viewer-main.js:541
msgid "This file looks like a copy of an existing .pad file in your account. Open the original to keep editing the linked pad, or create a new pad to fork the content stored in this file."
msgstr "Este archivo parece ser una copia de un archivo .pad existente en tu cuenta. Abre el original para seguir editando el pad enlazado, o crea un nuevo pad para crear una copia independiente del contenido almacenado en este archivo."

#: lib/Controller/EmbedController.php:85 src/viewer-main.js:555
msgid "We couldn't find a matching pad in this Nextcloud. You can create a new pad from the text stored in this file; from then on, opening this file will load the new pad."
msgstr "No se ha encontrado ningún pad correspondiente en este Nextcloud. Puedes crear un nuevo pad a partir del texto almacenado en este archivo; a partir de ese momento, abrir este archivo cargará el nuevo pad."

#: lib/Controller/EmbedController.php:86 src/viewer-main.js:545
msgid "Open the original .pad file"
msgstr "Abrir el archivo .pad original"

#: lib/Controller/EmbedController.php:87 src/viewer-main.js:529
#: src/viewer-main.js:550 src/viewer-main.js:560
msgid "Create new pad from this file"
msgstr "Crear nuevo pad a partir de este archivo"

#: lib/Controller/EmbedController.php:88 src/viewer-main.js:529
#: src/viewer-main.js:550 src/viewer-main.js:560
msgid "Creating new pad..."
msgstr "Creando nuevo pad..."

#: lib/Controller/EmbedController.php:89 src/viewer-main.js:23
msgid "Nextcloud did not answer. Check your connection and try again."
msgstr "Nextcloud no ha respondido. Comprueba tu conexión y vuelve a intentarlo."

#: lib/Controller/EmbedController.php:102
msgid "Invalid parent folder ID."
msgstr "ID de carpeta principal no válido."

#: lib/Controller/EmbedController.php:111
msgid "Creating pad..."
msgstr "Creando pad..."

#: lib/Controller/EmbedController.php:112
#: lib/Controller/EmbedController.php:121
#: lib/Controller/PadCreateController.php:48
#: lib/Controller/PadCreateController.php:69
msgid "Could not create pad"
msgstr "No se pudo crear el pad"

#: lib/Controller/EmbedController.php:113
msgid "Pad name is required."
msgstr "Se requiere el nombre del pad."

#: lib/Controller/EmbedController.php:114
msgid "Invalid access mode."
msgstr "Modo de acceso no válido."

#: lib/Controller/EmbedController.php:115
msgid "Embed configuration is incomplete."
msgstr "La configuración de incrustación está incompleta."

#: lib/Controller/EmbedController.php:116
msgid "This page creates a pad only inside the page that embeds it."
msgstr "Esta página solo crea un pad dentro de la página que la incrusta."

#: lib/Controller/EmbedController.php:117
msgid "Nextcloud did not answer. The pad may have been created anyway; look in the folder before you try again."
msgstr "Nextcloud no ha respondido. Puede que el pad se haya creado de todos modos; mira en la carpeta antes de volver a intentarlo."

#: lib/Controller/EmbedController.php:118
msgid "Pad creation failed."
msgstr "Se produjo un error al crear el pad."

#: lib/Controller/EmbedController.php:122
#: lib/Controller/PadControllerErrorMapper.php:124
#: lib/Controller/PadCreateController.php:66
msgid "Cannot resolve selected parent folder."
msgstr "No se puede resolver la carpeta principal seleccionada."

#: lib/Controller/EmbedControllerErrorMapper.php:59
#: lib/Controller/PadControllerErrorMapper.php:93
#: lib/Controller/PadCreateController.php:87
#: lib/Controller/ViewerControllerErrorMapper.php:50
msgid "Invalid input."
msgstr "Entrada no válida."

#: lib/Controller/EmbedControllerErrorMapper.php:64
#: lib/Controller/ViewerControllerErrorMapper.php:54
msgid "Cannot open selected .pad file."
msgstr "No se puede abrir el archivo .pad seleccionado."

#: lib/Controller/EmbedControllerErrorMapper.php:74
#: lib/Controller/PadControllerErrorMapper.php:126
msgid "Selected parent folder is not writable."
msgstr "La carpeta principal seleccionada no es modificable."

#: lib/Controller/PadControllerErrorMapper.php:103
#: lib/Controller/ViewerController.php:106
msgid "Invalid file path."
msgstr "Ruta de archivo no válida."

#: lib/Controller/PadControllerErrorMapper.php:107
msgid ".pad file not found."
msgstr "No se ha encontrado el archivo .pad."

#: lib/Controller/PadControllerErrorMapper.php:111
#: lib/Controller/PublicViewerControllerErrorMapper.php:97
msgid "Pad file is temporarily locked. Please retry."
msgstr "El archivo .pad está bloqueado temporalmente. Vuelve a intentarlo."

#: lib/Controller/PadControllerErrorMapper.php:117
msgid "The file changed while its pad was being set up. Try again."
msgstr "El archivo cambió mientras se configuraba su pad. Vuelve a intentarlo."

#: lib/Controller/PadControllerErrorMapper.php:120
#: lib/Controller/PadCreateController.php:46
#: lib/Controller/PadCreateController.php:67
#: lib/Controller/PadCreateController.php:89
msgid "A file with this name already exists."
msgstr "Ya existe un archivo con este nombre."

#: lib/Controller/PadControllerErrorMapper.php:122
msgid "This .pad file is already linked to a pad."
msgstr "Este archivo .pad ya está vinculado a un pad."

#: lib/Controller/PadControllerErrorMapper.php:128
msgid "Only someone who may edit this .pad file can do that."
msgstr "Solo quien puede editar este archivo .pad puede hacerlo."

#: lib/Controller/PadControllerErrorMapper.php:130
msgid "This pad type is disabled on this instance."
msgstr "Este tipo de pad está desactivado en esta instancia."

#: lib/Controller/PadControllerErrorMapper.php:149
msgid "This file is a legacy Ownpad link to a protected pad, and importing those is disabled on this server. Please contact your administrator."
msgstr "Este archivo es un enlace heredado de Ownpad a un pad protegido y su importación está desactivada en este servidor. Ponte en contacto con tu administración."

#: lib/Controller/PadControllerErrorMapper.php:155
msgid "This pad is already linked to another file you do not have access to."
msgstr "Este pad ya está vinculado a otro archivo al que no tienes acceso."

#: lib/Controller/PadControllerErrorMapper.php:161
#: lib/Controller/PublicViewerControllerErrorMapper.php:100
msgid "This pad is too large to show here. Open it in Etherpad instead."
msgstr "Este pad es demasiado grande para mostrarlo aquí. Ábrelo en Etherpad."

#: lib/Controller/PadControllerErrorMapper.php:166
msgid "This .pad file has no pad metadata yet."
msgstr "Este archivo .pad aún no tiene metadatos de pad."

#: lib/Controller/PadControllerErrorMapper.php:169
msgid "This .pad file names a pad that cannot be linked to it."
msgstr "Este archivo .pad hace referencia a un pad que no se puede vincular con él."

#: lib/Controller/PadControllerErrorMapper.php:171
#: lib/Controller/PublicViewerControllerErrorMapper.php:90
msgid "The selected .pad file has an invalid format."
msgstr "El archivo .pad seleccionado tiene un formato no válido."

#: lib/Controller/PadControllerErrorMapper.php:175
msgid "Etherpad refused the request. Please contact your administrator."
msgstr "Etherpad rechazó la solicitud. Ponte en contacto con tu administración."

#: lib/Controller/PadControllerErrorMapper.php:184
msgid "Etherpad cannot be reached right now. Try again later."
msgstr "No se puede acceder a Etherpad en este momento. Vuelve a intentarlo más tarde."

#: lib/Controller/PadControllerErrorMapper.php:200
msgid "The link to the pad on another server is not a valid https address."
msgstr "El enlace al pad de otro servidor no es una dirección https válida."

#: lib/Controller/PadControllerErrorMapper.php:201
msgid "The link to the pad on another server must not contain a user name or password."
msgstr "El enlace al pad de otro servidor no debe contener un nombre de usuario ni una contraseña."

#: lib/Controller/PadControllerErrorMapper.php:202
msgid "The link to the pad on another server must end in /p/ and the name of the pad."
msgstr "El enlace al pad de otro servidor debe terminar en /p/ y el nombre del pad."

#: lib/Controller/PadControllerErrorMapper.php:203
msgid "Only public pads on another server can be linked."
msgstr "Solo se pueden enlazar pads públicos de otro servidor."

#: lib/Controller/PadControllerErrorMapper.php:204
msgid "This .pad file names a pad on another server but has no valid link to it."
msgstr "Este archivo .pad nombra un pad de otro servidor, pero no tiene un enlace válido a él."

#: lib/Controller/PadControllerErrorMapper.php:205
msgid "Pads on other servers are switched off on this Nextcloud."
msgstr "Los pads de otros servidores están desactivados en este Nextcloud."

#: lib/Controller/PadControllerErrorMapper.php:206
msgid "This Nextcloud may not link to pads on that server. Your administrator can add it to the allowed servers."
msgstr "Este Nextcloud no puede enlazar pads de ese servidor. Tu administración puede añadirlo a los servidores permitidos."

#: lib/Controller/PadControllerErrorMapper.php:207
msgid "That server is on a local or private network, which this Nextcloud does not link to."
msgstr "Ese servidor está en una red local o privada, a la que este Nextcloud no enlaza."

#: lib/Controller/PadControllerErrorMapper.php:208
msgid "The server of the pad could not be found."
msgstr "No se encontró el servidor del pad."

#: lib/Controller/PadControllerErrorMapper.php:209
msgid "This Nextcloud cannot read pads on other servers: the PHP cURL extension is missing. Please contact your administrator."
msgstr "Este Nextcloud no puede leer pads de otros servidores: falta la extensión cURL de PHP. Ponte en contacto con tu administración."

#: lib/Controller/PadControllerErrorMapper.php:210
msgid "The server of the pad could not be reached. Try again later."
msgstr "No se pudo contactar con el servidor del pad. Vuelve a intentarlo más tarde."

#: lib/Controller/PadControllerErrorMapper.php:211
msgid "The server of the pad has no certificate this Nextcloud trusts."
msgstr "El servidor del pad no tiene un certificado en el que confíe este Nextcloud."

#: lib/Controller/PadControllerErrorMapper.php:212
msgid "The server of the pad sent the request on elsewhere, usually to a sign-in page. Only pads that can be read without signing in can be linked."
msgstr "El servidor del pad redirigió la solicitud, normalmente a una página de inicio de sesión. Solo se pueden enlazar pads que se puedan leer sin iniciar sesión."

#: lib/Controller/PadControllerErrorMapper.php:213
msgid "The server of the pad answered with an error ({status})."
msgstr "El servidor del pad respondió con un error ({status})."

#: lib/Controller/PadControllerErrorMapper.php:214
msgid "The pad was not found on the other server, or it cannot be exported there."
msgstr "No se encontró el pad en el otro servidor, o allí no se puede exportar."

#: lib/Controller/PadControllerErrorMapper.php:215
msgid "The server of the pad did not answer with the content of the pad."
msgstr "El servidor del pad no respondió con el contenido del pad."

#: lib/Controller/PadCreateController.php:65
msgid "Invalid pad name."
msgstr "Nombre de pad no válido."

#: lib/Controller/PadCreateController.php:88
msgid "Template file not found."
msgstr "Archivo de plantilla no encontrado."

#: lib/Controller/PadCreateController.php:91
msgid "Could not create pad from template."
msgstr "No se pudo crear el pad desde la plantilla."

#: lib/Controller/PadCreateController.php:103
msgid "Could not import external pad."
msgstr "No se pudo importar el pad externo."

#: lib/Controller/PadLifecycleController.php:54
msgid "Could not recover pad from this file."
msgstr "No se pudo recuperar el pad de este archivo."

#: lib/Controller/PadLifecycleController.php:95
msgid "Could not sync pad content."
msgstr "No se pudo sincronizar el contenido del pad."

#: lib/Controller/PadLifecycleController.php:108
msgid "Could not check pad sync status."
msgstr "No se pudo comprobar el estado de sincronización del pad."

#: lib/Controller/PadLifecycleController.php:124
msgid "Could not look up the original pad."
msgstr "No se pudo localizar el pad original."

#: lib/Controller/PadSessionController.php:99
#: lib/Controller/PadSessionController.php:111
msgid "Could not initialize .pad file."
msgstr "No se ha podido inicializar el archivo .pad."

#: lib/Controller/PadSessionController.php:124
msgid "Could not read pad metadata."
msgstr "No se pudieron leer los metadatos del pad."

#: lib/Controller/PadSessionController.php:142
msgid "Could not resolve .pad file."
msgstr "No se ha podido resolver el archivo .pad."

#: lib/Controller/PublicViewerControllerErrorMapper.php:78
msgid "This share link is invalid or has expired."
msgstr "Este enlace compartido no es válido o ha caducado."

#: lib/Controller/PublicViewerControllerErrorMapper.php:79
#: lib/Controller/PublicViewerControllerErrorMapper.php:82
msgid "This shared item is no longer available."
msgstr "Este elemento compartido ya no está disponible."

#: lib/Controller/PublicViewerControllerErrorMapper.php:80
msgid "The selected file is not part of this share."
msgstr "El archivo seleccionado no forma parte de este recurso compartido."

#: lib/Controller/PublicViewerControllerErrorMapper.php:83
msgid "This share link does not allow reading files."
msgstr "Este enlace compartido no permite leer archivos."

#: lib/Controller/PublicViewerControllerErrorMapper.php:85
msgid "This link does not point to a valid file."
msgstr "Este enlace no apunta a un archivo válido."

#: lib/Controller/PublicViewerControllerErrorMapper.php:86
msgid "No .pad file selected. Open a .pad file from this shared folder."
msgstr "No se ha seleccionado ningún archivo .pad. Abre un archivo .pad de esta carpeta compartida."

#: lib/Controller/PublicViewerControllerErrorMapper.php:88
msgid "The selected item is not a .pad document."
msgstr "El elemento seleccionado no es un documento .pad."

#: lib/Controller/PublicViewerControllerErrorMapper.php:89
msgid "The selected .pad file is missing required metadata."
msgstr "Al archivo .pad seleccionado le faltan metadatos obligatorios."

#: lib/Controller/PublicViewerControllerErrorMapper.php:93
msgid "This .pad file has no pad in this Nextcloud. Its owner can open it to restore the pad."
msgstr "Este archivo .pad no tiene ningún pad en este Nextcloud. Su propietario puede abrirlo para restaurar el pad."

#: lib/Controller/PublicViewerControllerErrorMapper.php:94
msgid "This pad is no longer on the Etherpad server. Its owner can open the file to make a new pad from its content."
msgstr "Este pad ya no está en el servidor de Etherpad. Su propietario puede abrir el archivo para crear un pad nuevo a partir de su contenido."

#: lib/Controller/PublicViewerControllerErrorMapper.php:95
msgid "Pad binding is inconsistent. Please contact the share owner."
msgstr "El vínculo del pad es incoherente. Ponte en contacto con quien lo ha compartido."

#: lib/Controller/PublicViewerControllerErrorMapper.php:101
msgid "Etherpad refused to open this shared pad. Please contact the share owner."
msgstr "Etherpad se negó a abrir este pad compartido. Ponte en contacto con quien lo ha compartido."

#: lib/Controller/PublicViewerControllerErrorMapper.php:102
msgid "The pad this file links to on another server could not be read."
msgstr "No se pudo leer el pad de otro servidor al que enlaza este archivo."

#: lib/Controller/PublicViewerControllerErrorMapper.php:104
msgid "Etherpad is currently unavailable for this shared pad."
msgstr "Etherpad no está disponible en este momento para este pad compartido."

#: lib/Controller/ViewerController.php:86
msgid "Cannot resolve file path for file ID."
msgstr "No se puede resolver la ruta del archivo para el ID del archivo."

#: lib/Listeners/RegisterTemplateCreatorListener.php:49
#: lib/Listeners/RegisterTemplateCreatorListener.php:51
msgid "New pad"
msgstr "Nuevo pad"

#: lib/Service/AdminConsistencyCheckResponseBuilder.php:27
msgid "Consistency check finished with issues."
msgstr "Comprobación de consistencia finalizada con problemas."

#: lib/Service/AdminConsistencyCheckResponseBuilder.php:28
msgid "Consistency check successful. No issues found."
msgstr "Comprobación de consistencia correcta. No se encontraron problemas."

#: lib/Service/AdminSettingsValidator.php:105
msgid "Etherpad API key is required."
msgstr "La clave API de Etherpad es obligatoria."

#: lib/Service/AdminSettingsValidator.php:116
msgid "Etherpad Base URL is required."
msgstr "La URL base de Etherpad es obligatoria."

#: lib/Service/AdminSettingsValidator.php:119
msgid "Etherpad Base URL must use https."
msgstr "La URL base de Etherpad debe usar HTTPS."

#: lib/Service/AdminSettingsValidator.php:124
msgid "Invalid Etherpad Base URL."
msgstr "URL base de Etherpad no válida."

#: lib/Service/AdminSettingsValidator.php:127
msgid "Etherpad Base URL must not include query or fragment."
msgstr "La URL base de Etherpad no debe incluir cadena de consulta ni fragmento."

#: lib/Service/AdminSettingsValidator.php:141
msgid "Invalid Etherpad API URL."
msgstr "URL API de Etherpad no válida."

#: lib/Service/AdminSettingsValidator.php:144
msgid "Etherpad API URL must not include query or fragment."
msgstr "La URL API de Etherpad no debe incluir cadena de consulta ni fragmento."

#: lib/Service/AdminSettingsValidator.php:149
msgid "Etherpad API URL must use http or https."
msgstr "La URL API de Etherpad debe usar HTTP o HTTPS."

#: lib/Service/AdminSettingsValidator.php:183
msgid "Cookie domain must be a hostname, not a URL."
msgstr "El dominio de la cookie debe ser un nombre de host, no una URL."

#: lib/Service/AdminSettingsValidator.php:189
#: lib/Service/AdminSettingsValidator.php:194
msgid "Cookie domain must be a valid shared hostname."
msgstr "El dominio de la cookie debe ser un nombre de host compartido válido."

#: lib/Service/AdminSettingsValidator.php:207
msgid "Invalid Etherpad API version format."
msgstr "Formato de versión de API de Etherpad no válido."

#: lib/Service/AdminSettingsValidator.php:219
msgid "Sync interval must be between 5 and 3600 seconds."
msgstr "El intervalo de sincronización debe estar entre 5 y 3600 segundos."

