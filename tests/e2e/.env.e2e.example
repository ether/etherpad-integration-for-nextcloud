# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Copy this file to tests/e2e/.env.e2e (gitignored) and fill in the
# values for YOUR test Nextcloud instance. Never commit real credentials.
#
# Use a dedicated throwaway test account, not your daily-driver user —
# the E2E specs create and delete .pad files on this instance.
#
# Instance/account requirements for full coverage (specs that need more
# than the basics skip themselves cleanly when it's missing):
#  - admin-health-check needs E2E_USER to be a Nextcloud admin.
#  - the external-pad spec needs allow_external_pads = yes, a
#    publicly-resolvable allowlisted Etherpad host, and E2E_EXTERNAL_PADS=1
#    below. It is declared rather than detected: a missing tile then fails
#    the test instead of skipping it.
#  - the cross-user specs need the optional second account below.

# Base URL of the Nextcloud instance under test (no trailing slash).
E2E_BASE_URL=https://cloud.example.test

# Optional login URL. Defaults to /login for normal Nextcloud instances.
# Use a relative path or a full URL. Useful for instances with social-login
# front doors, for example: /login?noredir=1#body-login
E2E_LOGIN_URL=/login

# Test-account web login (used once by auth.setup.ts to produce a browser
# session; password is never stored in the repo). Nextcloud app passwords
# are intentionally not used for the browser login form.
E2E_USER=e2e-tester
E2E_PASS=change-me

# App password for the same account, used for non-browser WebDAV/API
# setup and teardown. Create one under Settings → Security → Devices &
# sessions, or via `occ user:add-app-password`.
E2E_APP_PASSWORD=change-me-too

# Optional second test account, used only by cross-user specs (e.g.
# "user B may not open user A's pad" or "share revoke removes user B's
# access"). Leave unset to skip those specs.
#
# - E2E_USER2_APP_PASSWORD is enough for the API-only ownership-boundary
#   spec (BasicAuth against `open-by-id`).
# - E2E_USER2_PASS is the web-login password and is additionally needed
#   for specs that drive a USER2 browser session (e.g. the user-share
#   spec).
E2E_USER2=
E2E_USER2_PASS=
E2E_USER2_APP_PASSWORD=

# Set to 1 when the instance has allow_external_pads = yes and an allowlisted
# Etherpad host. Without it the external-pad spec skips; with it, a missing
# "Public pad from URL" tile fails the test instead of skipping it.
E2E_EXTERNAL_PADS=0
