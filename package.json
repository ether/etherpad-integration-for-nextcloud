		"typecheck:e2e": "tsc -p tests/e2e"
	},
	"devDependencies": {
		"@nextcloud/viewer": "^1.0.0",
		"@nextcloud/vite-config": "^2.5.4",
		"@playwright/test": "^1.63.0",
