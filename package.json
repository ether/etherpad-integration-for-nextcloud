	"private": true,
	"license": "AGPL-3.0-or-later",
	"type": "module",
	"engines": {
		"node": "^24.15.0",
		"npm": "^11.0.0"
	},
	"scripts": {
		"build": "node scripts/clean-js-build.mjs && vite build",
		"test": "vitest run",
		"test:watch": "vitest",
