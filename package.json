		"dotenv": "^18.0.4",
		"happy-dom": "^20.14.5",
		"jsdom": "^30.1.2",
		"typescript": "^6.0.3",
		"vite": "^7.3.6",
		"vitest": "^5.0.2"
	},
	"dependencies": {
		"dompurify": "^3.4.16"
	},
	"overrides": {
		"@nextcloud/viewer": {
			"vue": "^3.5.39"
		}
	}
