// Mutation testing of lib/ with Infection: .github/workflows/infection.yml
// runs it on the lines a pull request changes.
{
	"source": {
		"directories": ["lib"],
		// The bootstrap loads a stub of this class, so no test runs the real
		// one and none of its mutants could be caught.
		"excludes": ["AppInfo/Application.php"],
	},
	// Infection loads each class before it mutates it, and the OCP classes
	// those use exist here only as the unit suite's stubs.
	// LibClassesLoadTest keeps every class under lib/ loadable with them.
	"bootstrap": "tests/phpunit/bootstrap.php",
	"timeout": 20,
}
